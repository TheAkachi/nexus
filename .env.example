# Use: node --env-file=.env api/server.mjs
NODE_ENV=development
PORT=4183
PUBLIC_ORIGIN=http://127.0.0.1:4183
# Sem DATABASE_URL, PostgreSQL local via PGlite em .runtime/postgres.
# PostgreSQL externo: use URL fornecida pelo serviço, com TLS conforme fornecedor.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/primig
# DB_DIR=.runtime/postgres
# INDEXABLE=false
# Integração com a gestão comercial (contrato 19.2): id:hex de 32 bytes, a atual e a anterior. Vazio: desligada.
# INTEGRACAO_CHAVES=k1:<64 hex>
