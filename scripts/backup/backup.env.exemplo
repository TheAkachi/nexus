# Copiar para /etc/primig-p3-backup.env (root:root, chmod 600). Nunca versionar o arquivo preenchido.
# Senha do backup (16+ caracteres). Guardar também fora da VPS (gerenciador de senhas): sem ela o backup não abre.
BACKUP_PASSPHRASE=
# Pasta dos backups na VPS e por quantos dias ficam.
BACKUP_DIR=/var/backups/primig-p3
KEEP_DAYS=30
# Cópia fora da VPS (rclone). Vazio = só na VPS. Exemplo: gdrive:PRIMIG/backups
RCLONE_REMOTE=
REMOTE_KEEP_DAYS=90
